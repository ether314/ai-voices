# Required — https://play.cartesia.ai/keys
CARTESIA_API_KEY=sk_car_...

# Required — https://cursor.com/dashboard/integrations
CURSOR_API_KEY=cursor_...

# Optional overrides (CARTESIA_VOICE_ID also persisted via UI to data/cartesia_voice_id.txt)
# Default Jack (account clone). Joe Marazzo: 55e8e671-7e46-4a15-9b53-4955c92aec0c
# CARTESIA_VOICE_ID=7e94372f-47be-42b7-ba88-1c1f463da123
CURSOR_MODEL=composer-2.5
# Cursor SDK agent runtime for the "cursor" LLM backend. Only "local" is supported
# (runs on this machine via the Cursor local bridge). Do not set "cloud" — Joe will
# refuse to start rather than fall back to a Cursor cloud / background-composer VM.
# CURSOR_RUNTIME=local

# Reply LLM: cursor (Cursor SDK local) or local (OpenAI-compatible chat API)
# Also persisted via UI to data/llm_backend.txt, data/local_llm_url.txt, data/local_llm_model.txt
# LLM_BACKEND=cursor
# LOCAL_LLM_URL=http://127.0.0.1:11434/v1
# LOCAL_LLM_MODEL=llama3.2
# Optional Bearer token for local servers that require one (default: ollama)
# LOCAL_LLM_API_KEY=ollama

# Optional audio devices — numeric index OR name substring (name is more stable):
# AUDIO_INPUT_DEVICE=Stereo Mix
# AUDIO_OUTPUT_DEVICE=Speakers (Realtek
# AUDIO_INPUT_GAIN=5.0
# AUDIO_OUTPUT_GAIN=2.5
# Default auto-pick prefers Stereo Mix / loopback when present (TikTok / browser livestream).
# AUDIO_EXTERNAL_VOICE=1
# Force laptop/room mic instead of system audio:
# AUDIO_PREFER_MIC=1
# AUDIO_EXTERNAL_VOICE=0

# Voice engine: cartesia (cloud Sonic) or local (Chatterbox Docker GPU/CPU)
# TTS_BACKEND=cartesia
# CHATTERBOX_URL=http://127.0.0.1:8090
