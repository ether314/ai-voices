# Required — https://play.cartesia.ai/keys
CARTESIA_API_KEY=sk_car_...

# Required — https://cursor.com/dashboard/integrations
CURSOR_API_KEY=cursor_...

# Optional overrides (CARTESIA_VOICE_ID also persisted via UI to data/cartesia_voice_id.txt)
# CARTESIA_VOICE_ID=55e8e671-7e46-4a15-9b53-4955c92aec0c
CURSOR_MODEL=composer-2.5

# Optional audio devices — numeric index OR name substring (name is more stable):
# AUDIO_INPUT_DEVICE=Stereo Mix
# AUDIO_OUTPUT_DEVICE=Speakers (Realtek
# AUDIO_INPUT_GAIN=5.0
# AUDIO_OUTPUT_GAIN=2.5
# Default auto-pick prefers Stereo Mix / loopback when present (TikTok / browser livestream).
# AUDIO_EXTERNAL_VOICE=1
# Force laptop/room mic instead of system audio:
# AUDIO_PREFER_MIC=1
# AUDIO_EXTERNAL_VOICE=0

# Voice engine: cartesia (cloud Sonic) or local (Chatterbox Docker GPU/CPU)
# TTS_BACKEND=cartesia
# CHATTERBOX_URL=http://127.0.0.1:8090
